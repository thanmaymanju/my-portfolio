# GEMINI_API_KEY: Optional for live Floating AI Assistant responses.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE_URL & SUPABASE_SERVICE_ROLE_KEY: Optional server-side credentials
# for storing contact form messages and powering the admin message inbox.
# Never expose SUPABASE_SERVICE_ROLE_KEY in client-side code.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# ADMIN_ACCESS_TOKEN: Optional bearer token to guard /api/admin/* endpoints.
ADMIN_ACCESS_TOKEN=""
